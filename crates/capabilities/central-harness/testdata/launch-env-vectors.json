{
  "comment": "Shared launch-env vectors (phase 2b spec decision 11). harness.ValidateLaunchEnv(env, nil) must accept exactly the vectors marked accept, and central-harness-launcherd must refuse every other one with env_refused. A vector with wire false cannot be written as a NAME=value request entry (its name holds '=' or NUL), so only the Go test checks it; the Go client refuses such a name before encoding.",
  "vectors": [
    {"id": "empty", "env": {}, "accept": true},
    {"id": "base-allowlist", "env": {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "LANGUAGE": "en", "TERM": "xterm-256color", "COLORTERM": "truecolor", "NO_COLOR": "1", "TZ": "UTC", "TMPDIR": "/tmp", "USER": "operator", "LOGNAME": "operator", "SHELL": "/bin/sh"}, "accept": true},
    {"id": "lc-prefix", "env": {"LC_ALL": "C.UTF-8", "LC_CTYPE": "C.UTF-8", "LC_MESSAGES": "C"}, "accept": true},
    {"id": "lc-prefix-bare", "env": {"LC_": "x"}, "accept": true},
    {"id": "user-logname-only", "env": {"USER": "someone-else", "LOGNAME": "someone-else"}, "accept": true},
    {"id": "value-with-equals", "env": {"PATH": "/a=b:/c"}, "accept": true},
    {"id": "empty-value", "env": {"TERM": ""}, "accept": true},
    {"id": "central-attempt-scope", "env": {"CENTRAL_ATTEMPT_SCOPE": "0193c5c5-9b0e-7f3a-9b0e-9b0e9b0e9b0e:0193c5c5-9b0e-7f3a-9b0e-9b0e9b0e9b0e:0193c5c5-9b0e-7f3a-9b0e-9b0e9b0e9b0e"}, "accept": true},

    {"id": "home", "env": {"HOME": "/tmp/elsewhere"}, "accept": false},
    {"id": "home-lower", "env": {"home": "/tmp/elsewhere"}, "accept": false},
    {"id": "not-allowlisted", "env": {"EDITOR": "vi"}, "accept": false},
    {"id": "allowlist-is-case-sensitive", "env": {"Path": "/usr/bin"}, "accept": false},
    {"id": "lc-prefix-is-case-sensitive", "env": {"lc_all": "C"}, "accept": false},
    {"id": "one-bad-name-refuses-all", "env": {"PATH": "/usr/bin", "LD_PRELOAD": "/tmp/x.so"}, "accept": false},

    {"id": "deny-exact-claude-config-dir", "env": {"CLAUDE_CONFIG_DIR": "/tmp/c"}, "accept": false},
    {"id": "deny-exact-opencode-config-dir", "env": {"OPENCODE_CONFIG_DIR": "/tmp/c"}, "accept": false},
