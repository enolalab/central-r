    {"id": "malformed-empty-name", "env": {"": "x"}, "accept": false},
    {"id": "malformed-leading-digit", "env": {"1PATH": "x"}, "accept": false},
    {"id": "malformed-dash", "env": {"LC-ALL": "x"}, "accept": false},
    {"id": "malformed-space", "env": {"LC ALL": "x"}, "accept": false},
    {"id": "malformed-dot", "env": {"LC_A.B": "x"}, "accept": false},
    {"id": "malformed-non-ascii", "env": {"LC_\u00c9": "x"}, "accept": false},
    {"id": "malformed-equals-in-name", "env": {"PATH=/tmp/evil": "x"}, "accept": false, "wire": false},
    {"id": "malformed-nul-in-name", "env": {"PATH\u0000X": "x"}, "accept": false, "wire": false}
  ]
