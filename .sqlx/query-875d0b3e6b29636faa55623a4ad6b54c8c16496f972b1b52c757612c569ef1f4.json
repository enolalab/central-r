  "db_name": "PostgreSQL",
  "query": "SELECT e.id, e.run_id, e.seq, e.node_id, n.node_key, e.reason_code, n.ready_at, e.recorded_at FROM central.run_events e JOIN central.workflow_nodes n ON n.id = e.node_id WHERE e.run_id = $1 AND e.kind = 'admission_deferred' ORDER BY COALESCE(n.ready_at, n.created_at), n.node_key",
