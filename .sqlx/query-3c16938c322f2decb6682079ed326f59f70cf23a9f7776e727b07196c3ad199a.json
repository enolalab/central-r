  "query": "SELECT r.id, r.task_id, r.run_id, r.step_id, r.logical_operation_id, r.physical_attempt_id, r.invocation_id, r.invocation_generation, r.final_state, r.outcome::text AS \"outcome!\", r.context::text AS \"context?\", r.producer_id FROM central.execution_completion_receipts r JOIN central.step_attempts a ON a.workspace_id = r.workspace_id AND a.id = r.step_attempt_id WHERE r.workspace_id = $1 AND r.step_attempt_id = $2 AND r.invocation_id = a.invocation_id AND r.invocation_generation = a.invocation_generation LIMIT 1",
