  "query": "SELECT event_sequence, COALESCE(task_id, aggregate_id) AS \"task_id!\", run_id, kind, COALESCE(state, '') AS \"state!\", occurred_at FROM central.events WHERE workspace_id = $1 AND ($3::uuid IS NULL OR aggregate_id = $3) AND ($4::bigint IS NULL OR event_sequence < $4) AND kind <> ALL($5::text[]) ORDER BY event_sequence DESC LIMIT $2",
