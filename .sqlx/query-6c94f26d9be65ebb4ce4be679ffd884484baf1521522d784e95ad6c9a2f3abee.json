  "query": "SELECT a.id, a.node_id, n.node_key, a.attempt_seq, a.state, a.dispatch_reason_code, a.worker_id, a.claimed_at, a.started_at, a.ended_at, h.adapter_version AS \"adapter_version?\", h.harness_version, n.spec FROM central.session_attempts a JOIN central.workflow_nodes n ON n.id = a.node_id LEFT JOIN central.harness_attempts h ON h.id = a.harness_attempt_id WHERE a.node_id = $1 ORDER BY a.attempt_seq",
