  "query": "SELECT id, task_id, run_id, state, sensitivity, disposition, detected_media_type, size, COALESCE(required_role, '') AS \"required_role!\", COALESCE(producer_id, '') AS \"producer_id!\", created_at, updated_at, ready_at FROM central.artifacts WHERE workspace_id = $1 AND task_id = $2 AND ($3::timestamptz IS NULL OR (updated_at, id) < ($3, $4::uuid)) ORDER BY updated_at DESC, id DESC LIMIT $5",
