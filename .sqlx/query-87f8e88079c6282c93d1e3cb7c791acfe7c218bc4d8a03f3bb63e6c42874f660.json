{
  "db_name": "PostgreSQL",
  "query": "SELECT n.id, n.run_id, n.node_key, n.state, n.attempt_count, n.max_attempts, n.not_before, n.created_at, p.node_key AS \"parent_key?\", COALESCE(r.reason_code, '') AS \"reason!\" FROM central.workflow_nodes n LEFT JOIN central.workflow_nodes p ON p.id = n.parent_node_id LEFT JOIN LATERAL ( SELECT e.reason_code FROM central.run_events e WHERE e.run_id = n.run_id AND e.node_id = n.id AND e.reason_code IS NOT NULL ORDER BY e.seq DESC LIMIT 1 ) r ON true WHERE n.workspace_id = $1 AND n.id = $2",
