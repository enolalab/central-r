  "query": "SELECT id, workspace_id, status, current_run_id, COALESCE(waiting_reason, '') AS \"waiting_reason!\", retry_count, title, COALESCE(failure_reason, '') AS \"failure_reason!\", retry_eligible_at, updated_at, created_at FROM central.tasks WHERE workspace_id = $1 AND ($3::text IS NULL OR (status > $3 OR (status = $3 AND (updated_at, id) < ($4, $5)))) ORDER BY status ASC, updated_at DESC, id DESC LIMIT $2",
