{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.task_id, r.workspace_id, r.run_index, r.status, r.run_key, r.created_at, r.updated_at, r.deadline, ev.started_at, ev.ended_at, COALESCE(nc.counts, '{}'::jsonb) AS \"counts!\" FROM central.runs r LEFT JOIN LATERAL ( SELECT MIN(e.recorded_at) AS started_at, MAX(e.recorded_at) AS ended_at FROM central.run_events e WHERE e.run_id = r.id ) ev ON true LEFT JOIN LATERAL ( SELECT jsonb_object_agg(state, cnt) AS counts FROM ( SELECT n.state, COUNT(*) AS cnt FROM central.workflow_nodes n WHERE n.run_id = r.id GROUP BY n.state ) counted ) nc ON true WHERE r.workspace_id = $1 AND r.id = $2",
