{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id, a.run_id, l.node_id, n.node_key, l.attempt_id, a.attempt_seq, l.worker_id, l.issued_at, l.last_heartbeat_at, (EXTRACT(EPOCH FROM (now() - l.last_heartbeat_at)))::bigint AS \"heartbeat_age_seconds!\", l.expires_at, l.heartbeat_interval_seconds FROM central.node_leases l JOIN central.session_attempts a ON a.id = l.attempt_id JOIN central.workflow_nodes n ON n.id = l.node_id WHERE a.workspace_id = $1 AND l.released_at IS NULL ORDER BY l.issued_at, l.id",
