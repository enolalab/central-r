{
  "db_name": "PostgreSQL",
  "query": "SELECT e.epoch_generation, e.coordinator_fence, e.state, w.delivery_state, w.watermark_created_at, w.watermark_run_id, r.created_at, r.id AS run_id, r.reconciled_epoch FROM central.runs r JOIN central.recovery_epoch_workspaces w ON w.workspace_id = r.workspace_id JOIN central.recovery_epochs e ON e.epoch_generation = w.epoch_generation WHERE r.workspace_id = $1 AND r.task_id = $2 AND r.id = $3 AND e.state <> 'completed' ORDER BY e.epoch_generation DESC LIMIT 1",
