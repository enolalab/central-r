  "query": "SELECT id, capability_identity, scope, action, actor_identity, state, suspend_reason, reason, authority_identity, created_at, updated_at, expiry_at FROM central.approvals WHERE workspace_id = $1 AND actor_identity = $2 AND ($3::uuid IS NULL OR task_id = $3) AND ($4::timestamptz IS NULL OR (updated_at, id) < ($4::timestamptz, $5::uuid)) ORDER BY updated_at DESC, id DESC LIMIT $6",
